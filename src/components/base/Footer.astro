---
import Link from './Link.astro'
import { SITE } from '~/config'

const currentYear = new Date().getFullYear()

const copyrightText = `© ${currentYear} ${SITE.author}`
---

<footer class="slide-enter animate-delay-1600! px-7 mt-auto mb-8">
  <div class="prose mx-auto op-50">
    <div
      class="flex lt-sm:flex-col items-center text-sm whitespace-nowrap gap-x-1"
    >
      <span>{copyrightText}</span>
      <a
        href="https://beian.miit.gov.cn/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:underline">黔ICP备2024040088号</a
      >
    </div>
  </div>
</footer>
